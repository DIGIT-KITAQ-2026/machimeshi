# Supabaseプロジェクトの Settings > API から取得できる値をコピーしてください。
# 手順の詳細は specifications/supabase_setup.md を参照してください。
#
# 使い方: このファイルを .env という名前でコピーし、実際の値を入力する。
#   cp .env.example .env

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Claude Agent SDK（scripts/askClaude.ts, scripts/claudeServer.ts）用。
# 基本的には設定不要（未設定ならこのマシンの`claude login`セッションを使い、
# 従量課金のAPI利用にはならない）。従量課金のAPIキーを使いたい場合のみ、
# https://platform.claude.com/ の Settings > API Keys で発行して設定する。
# 注意: 上のVITE_接頭辞の変数と違い、これはNode.jsスクリプト専用でブラウザ側には一切公開されない。
# ANTHROPIC_API_KEY=sk-ant-your-api-key
